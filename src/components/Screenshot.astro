---
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata | string;
  dark: ImageMetadata | string;
  alt: string;
  caption?: string;
}
const { light, dark, alt, caption } = Astro.props;
if (!alt || alt.trim() === '') {
  throw new Error('<Screenshot>: alt text is required. Say what the reader should notice.');
}
const src = (i: ImageMetadata | string) => (typeof i === 'string' ? i : i.src);
---

<figure class="kb-screenshot">
  <img class="kb-screenshot__light" src={src(light)} alt={alt} loading="lazy" />
  <img class="kb-screenshot__dark" src={src(dark)} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
