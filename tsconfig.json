{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.mjs",
    "*.ts"
  ],
  "exclude": ["dist", "tests/fixtures", "tmp-fixtures"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true
  }
}
